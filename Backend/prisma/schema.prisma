generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model College {
  name                String
  slug                String                 @unique
  registrationNo      String?
  address             String?
  status              String                 @default("trial")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  academicYear        String?
  affiliationCode     String?
  aicteNumber         String?
  logoUrl             String?
  ugcCode             String?
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admissions          Admission[]
  assignments         Assignment[]
  assignmentSubs      AssignmentSubmission[]
  attendance          Attendance[]
  billingSubscription BillingSubscription?
  complaints          Complaint[]
  courses             Course[]
  departments         Department[]
  documents           DocumentVault[]
  enrollments         Enrollment[]
  exams               Exam[]
  fees                Fee[]
  feeStructures       FeeStructure[]
  hostelBlocks        HostelBlock[]
  infrastructure      InfrastructureAsset[]
  leaveRequests       LeaveRequest[]
  libraryItems        LibraryItem[]
  marks               Mark[]
  notices             Notice[]
  parents             Parent[]
  paymentTransactions PaymentTransaction[]
  payrollRecords      PayrollRecord[]
  placements          Placement[]
  roles               Role[]
  scholarships        Scholarship[]
  sections            Section[]
  storeItems          StoreItem[]
  students            Student[]
  teachers            Teacher[]
  timetableSlots      TimetableSlot[]
  transportRoutes     TransportRoute[]
  users               User[]
  projects            Project[]
}

model BillingSubscription {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId        String    @unique @db.Uuid
  planTier         String
  pricePerStudent  Float
  maxStudents      Int
  storageLimitGb   Int
  status           String
  trialExpiresAt   DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  college          College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Lead {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeName String
  contactName String
  email       String
  phone       String?
  district    String?
  status      String   @default("trial")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformTicket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String   @db.Uuid
  subject     String
  description String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User     @relation(fields: [adminUserId], references: [id])
}

model User {
  email          String
  name           String?
  role           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  accountStatus  String           @default("pending")
  lastLoginAt    DateTime?
  passwordHash   String
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId      String?          @db.Uuid
  customRoleId   String?          @db.Uuid
  customRole     Role?            @relation("UserCustomRole", fields: [customRoleId], references: [id])
  parentProfile  Parent?
  tickets        PlatformTicket[]
  refreshTokens  RefreshToken[]
  studentProfile Student?
  teacherProfile Teacher?
  college        College?         @relation(fields: [collegeId], references: [id])
  complaints     Complaint[]
  payrollRecords PayrollRecord[]
  timesheets     Timesheet[]

  @@unique([collegeId, email])
  @@index([collegeId])
}

model Role {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  collegeId    String           @db.Uuid
  college      College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  isSystemRole Boolean          @default(false)
  users        User[]           @relation("UserCustomRole")
  permissions  RolePermission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([name, collegeId])
}

model Module {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  label       String
  permissions RolePermission[]
}

model RolePermission {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId    String  @db.Uuid
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId  String  @db.Uuid
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([roleId, moduleId])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  name       String
  code       String
  createdAt  DateTime    @default(now())
  hodUserId  String?     @db.Uuid
  updatedAt  DateTime    @updatedAt
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId  String      @db.Uuid
  admissions Admission[]
  courses    Course[]
  college    College     @relation(fields: [collegeId], references: [id])
  students   Student[]
  teachers   Teacher[]

  @@index([collegeId])
}

model Course {
  name         String
  code         String
  semester     Int
  credits      Int
  collegeId    String          @db.Uuid
  createdAt    DateTime        @default(now())
  deletedAt    DateTime?
  syllabusUrl  String?
  updatedAt    DateTime        @updatedAt
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String          @db.Uuid
  assignments  Assignment[]
  attendance   Attendance[]
  college      College         @relation(fields: [collegeId], references: [id])
  department   Department      @relation(fields: [departmentId], references: [id])
  enrollments  Enrollment[]
  exams        Exam[]
  sections     Section[]
  timetable    TimetableSlot[]

  @@index([collegeId])
}

model Section {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String          @db.Uuid
  courseId  String          @db.Uuid
  name      String
  capacity  Int
  createdAt DateTime        @default(now())
  college   College         @relation(fields: [collegeId], references: [id])
  course    Course          @relation(fields: [courseId], references: [id])
  students  Student[]
  timetable TimetableSlot[]
  teachers  Teacher[]       @relation("TeacherSections")

  @@index([collegeId])
}

model Teacher {
  designation  String
  joiningDate  DateTime
  createdAt    DateTime        @default(now())
  deletedAt    DateTime?
  salaryGrade  String?
  updatedAt    DateTime        @updatedAt
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String          @unique @db.Uuid
  departmentId String          @db.Uuid
  collegeId    String          @db.Uuid
  assignments  Assignment[]
  attendance   Attendance[]
  college      College         @relation(fields: [collegeId], references: [id])
  department   Department      @relation(fields: [departmentId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  timetable    TimetableSlot[]
  sections     Section[]       @relation("TeacherSections")

  @@index([collegeId])
}

model Student {
  rollNumber       String
  admissionNumber  String
  batchYear        String
  bloodGroup       String?
  createdAt        DateTime               @default(now())
  deletedAt        DateTime?
  emergencyContact String?
  sectionId        String?                @db.Uuid
  updatedAt        DateTime               @updatedAt
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                 @unique @db.Uuid
  departmentId     String                 @db.Uuid
  collegeId        String                 @db.Uuid
  assignmentSubs   AssignmentSubmission[]
  attendance       Attendance[]
  enrollments      Enrollment[]
  fees             Fee[]
  marks            Mark[]
  parents          ParentStudentLink[]
  scholarships     Scholarship[]
  college          College                @relation(fields: [collegeId], references: [id])
  department       Department             @relation(fields: [departmentId], references: [id])
  section          Section?               @relation(fields: [sectionId], references: [id])
  user             User                   @relation(fields: [userId], references: [id])

  @@index([collegeId])
}

model Parent {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String              @db.Uuid
  userId    String              @unique @db.Uuid
  createdAt DateTime            @default(now())
  college   College             @relation(fields: [collegeId], references: [id])
  user      User                @relation(fields: [userId], references: [id])
  students  ParentStudentLink[]

  @@index([collegeId])
}

model ParentStudentLink {
  parentId  String  @db.Uuid
  studentId String  @db.Uuid
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model Enrollment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  studentId String   @db.Uuid
  courseId  String   @db.Uuid
  semester  Int
  status    String   @default("enrolled")
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([collegeId, studentId])
}

model Admission {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId         String     @db.Uuid
  applicantName     String
  marksheetDetails  Json
  departmentId      String     @db.Uuid
  status            String
  cutoffCheckResult Json?
  seatHoldExpiresAt DateTime?
  createdFromLeadId String?    @db.Uuid
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  college           College    @relation(fields: [collegeId], references: [id])
  department        Department @relation(fields: [departmentId], references: [id])

  @@index([collegeId, status])
}

model Attendance {
  date                  DateTime @db.Date
  status                String
  collegeId             String   @db.Uuid
  isLateEntry           Boolean  @default(false)
  markedAt              DateTime @default(now())
  submittedWithinWindow Boolean  @default(true)
  teacherId             String   @db.Uuid
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId             String   @db.Uuid
  courseId              String   @db.Uuid
  college               College  @relation(fields: [collegeId], references: [id])
  course                Course   @relation(fields: [courseId], references: [id])
  student               Student  @relation(fields: [studentId], references: [id])
  teacher               Teacher  @relation(fields: [teacherId], references: [id])

  @@index([collegeId, studentId, date])
}

model Exam {
  name      String
  date      DateTime @db.Date
  maxMarks  Float
  collegeId String   @db.Uuid
  createdAt DateTime @default(now())
  status    String   @default("pending")
  type      String
  updatedAt DateTime @updatedAt
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String   @db.Uuid
  college   College  @relation(fields: [collegeId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  marks     Mark[]

  @@index([collegeId, courseId])
}

model Mark {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId          String   @db.Uuid
  examId             String   @db.Uuid
  studentId          String   @db.Uuid
  obtainedMarks      Float
  remarks            String?
  enteredByTeacherId String   @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  college            College  @relation(fields: [collegeId], references: [id])
  exam               Exam     @relation(fields: [examId], references: [id])
  student            Student  @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([collegeId, studentId])
}

model FeeStructure {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId    String   @db.Uuid
  semester     Int
  departmentId String?  @db.Uuid
  totalAmount  Float
  dueDate      DateTime
  createdAt    DateTime @default(now())
  fees         Fee[]
  college      College  @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
}

model Fee {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId      String               @db.Uuid
  studentId      String               @db.Uuid
  feeStructureId String               @db.Uuid
  status         String               @default("pending")
  amountDue      Float
  amountPaid     Float                @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  college        College              @relation(fields: [collegeId], references: [id])
  feeStructure   FeeStructure         @relation(fields: [feeStructureId], references: [id])
  student        Student              @relation(fields: [studentId], references: [id])
  transactions   PaymentTransaction[]

  @@index([collegeId, status])
  @@index([collegeId, studentId])
}

model Scholarship {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String   @db.Uuid
  studentId     String   @db.Uuid
  category      String
  amountCovered Float
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  college       College  @relation(fields: [collegeId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])

  @@index([collegeId, studentId])
}

model PaymentTransaction {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId  String    @db.Uuid
  feeId      String    @db.Uuid
  gateway    String
  gatewayRef String?
  amount     Float
  status     String
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  college    College   @relation(fields: [collegeId], references: [id])
  fee        Fee       @relation(fields: [feeId], references: [id])

  @@index([collegeId])
}

model LeaveRequest {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId           String   @db.Uuid
  requesterUserId     String   @db.Uuid
  requesterRole       String
  fromDate            DateTime @db.Date
  toDate              DateTime @db.Date
  reason              String
  medicalCertUrl      String?
  status              String   @default("pending")
  reviewedBy          String?  @db.Uuid
  substituteTeacherId String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  college             College  @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
}

model TimetableSlot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId    String   @db.Uuid
  departmentId String   @db.Uuid
  sectionId    String   @db.Uuid
  dayOfWeek    Int
  startTime    String
  endTime      String
  courseId     String   @db.Uuid
  teacherId    String   @db.Uuid
  room         String
  createdAt    DateTime @default(now())
  college      College  @relation(fields: [collegeId], references: [id])
  course       Course   @relation(fields: [courseId], references: [id])
  section      Section  @relation(fields: [sectionId], references: [id])
  teacher      Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([collegeId, dayOfWeek, startTime, room], name: "unique_room_booking")
  @@unique([collegeId, dayOfWeek, startTime, teacherId], name: "unique_teacher_booking")
  @@index([collegeId, teacherId, dayOfWeek])
}

model Assignment {
  title         String
  description   String
  dueDate       DateTime
  attachmentUrl String?
  collegeId     String                 @db.Uuid
  createdAt     DateTime               @default(now())
  teacherId     String                 @db.Uuid
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String                 @db.Uuid
  college       College                @relation(fields: [collegeId], references: [id])
  course        Course                 @relation(fields: [courseId], references: [id])
  teacher       Teacher                @relation(fields: [teacherId], references: [id])
  submissions   AssignmentSubmission[]

  @@index([collegeId, courseId])
}

model AssignmentSubmission {
  status       String     @default("submitted")
  fileUrl      String
  submittedAt  DateTime   @default(now())
  collegeId    String     @db.Uuid
  feedback     String?
  score        Float?
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String     @db.Uuid
  studentId    String     @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  college      College    @relation(fields: [collegeId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([collegeId, studentId])
}

model LibraryItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId       String   @db.Uuid
  title           String
  author          String?
  isbn            String?
  category        String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  location        String?
  college         College  @relation(fields: [collegeId], references: [id])
}

model HostelBlock {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String  @db.Uuid
  name      String
  college   College @relation(fields: [collegeId], references: [id])
}

model TransportRoute {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String  @db.Uuid
  name      String
  college   College @relation(fields: [collegeId], references: [id])
}

model InfrastructureAsset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  type      String   @default("other")
  capacity  Int      @default(0)
  location  String   @default("")
  status    String   @default("active")
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id])
}

model Notice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId      String   @db.Uuid
  title          String
  content        String   @default("")
  priority       String   @default("normal")
  targetAudience String   @default("all")
  createdAt      DateTime @default(now())
  college        College  @relation(fields: [collegeId], references: [id])
}

model Complaint {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String   @db.Uuid
  userId      String   @db.Uuid
  subject     String
  description String
  category    String
  priority    String   @default("medium")
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  college     College  @relation(fields: [collegeId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([collegeId, status])
  @@index([userId])
}

model PayrollRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String   @db.Uuid
  userId      String   @db.Uuid
  month       String
  basicSalary Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netSalary   Float
  status      String   @default("pending") // pending, paid
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college     College  @relation(fields: [collegeId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([collegeId, userId])
}

model Project {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String      @db.Uuid
  name        String
  description String?
  status      String      @default("active") // active, completed
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  college     College     @relation(fields: [collegeId], references: [id])
  timesheets  Timesheet[]

  @@index([collegeId])
}

model Timesheet {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           String   @db.Uuid
  userId              String   @db.Uuid
  date                DateTime
  hoursSpent          Float
  activityDescription String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
}

model Placement {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String  @db.Uuid
  companyName String
  eligibility Json?
  college     College @relation(fields: [collegeId], references: [id])
}

model StoreItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String  @db.Uuid
  name      String
  college   College @relation(fields: [collegeId], references: [id])
}

model DocumentVault {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String  @db.Uuid
  fileName  String
  college   College @relation(fields: [collegeId], references: [id])
}
