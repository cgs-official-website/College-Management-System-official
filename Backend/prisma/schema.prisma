generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------
// PLATFORM LAYER (Superadmin Scope)
// ----------------------------------------------------------------------

model College {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String    @unique
  aicteNumber      String?
  ugcCode          String?
  affiliationCode  String?
  logoUrl          String?
  address          String?
  status           String    @default("trial") // trial | active | suspended
  academicYear     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relationships
  users               User[]
  billingSubscription BillingSubscription?
  departments         Department[]
  courses             Course[]
  sections            Section[]
  teachers            Teacher[]
  students            Student[]
  parents             Parent[]
  enrollments         Enrollment[]
  admissions          Admission[]
  attendance          Attendance[]
  exams               Exam[]
  marks               Mark[]
  feeStructures       FeeStructure[]
  fees                Fee[]
  scholarships        Scholarship[]
  paymentTransactions PaymentTransaction[]
  leaveRequests       LeaveRequest[]
  timetableSlots      TimetableSlot[]
  assignments         Assignment[]
  assignmentSubs      AssignmentSubmission[]
  libraryItems        LibraryItem[]
  hostelBlocks        HostelBlock[]
  transportRoutes     TransportRoute[]
  infrastructure      InfrastructureAsset[]
  notices             Notice[]
  complaints          Complaint[]
  placements          Placement[]
  storeItems          StoreItem[]
  payrollRecords      PayrollRecord[]
  documents           DocumentVault[]
}

model BillingSubscription {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId        String    @unique @db.Uuid
  planTier         String
  pricePerStudent  Float
  maxStudents      Int
  storageLimitGb   Int
  status           String
  trialExpiresAt   DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Lead {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeName String
  contactName String
  email       String
  phone       String?
  district    String?
  status      String   @default("trial") // trial | converted | lost
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformTicket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String   @db.Uuid
  subject     String
  description String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin User @relation(fields: [adminUserId], references: [id])
}

// ----------------------------------------------------------------------
// IDENTITY & RBAC
// ----------------------------------------------------------------------

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String?   @db.Uuid // Nullable ONLY for superadmin
  email         String
  passwordHash  String
  role          String    // superadmin | admin | teacher | hod | student | parent
  accountStatus String    @default("pending") // pending | active | suspended
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  college        College?        @relation(fields: [collegeId], references: [id])
  refreshTokens  RefreshToken[]
  studentProfile Student?
  teacherProfile Teacher?
  parentProfile  Parent?
  tickets        PlatformTicket[]

  @@unique([collegeId, email])
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------
// ACADEMIC STRUCTURE
// ----------------------------------------------------------------------

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String   @db.Uuid
  name        String
  code        String
  hodUserId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college    College    @relation(fields: [collegeId], references: [id])
  courses    Course[]
  students   Student[]
  teachers   Teacher[]
  admissions Admission[]

  @@index([collegeId])
}

model Course {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId    String   @db.Uuid
  departmentId String   @db.Uuid
  name         String
  code         String
  semester     Int
  credits      Int
  syllabusUrl  String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college     College       @relation(fields: [collegeId], references: [id])
  department  Department    @relation(fields: [departmentId], references: [id])
  sections    Section[]
  enrollments Enrollment[]
  attendance  Attendance[]
  exams       Exam[]
  timetable   TimetableSlot[]
  assignments Assignment[]

  @@index([collegeId])
}

model Section {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  courseId  String   @db.Uuid
  name      String
  capacity  Int
  createdAt DateTime @default(now())

  college   College    @relation(fields: [collegeId], references: [id])
  course    Course     @relation(fields: [courseId], references: [id])
  students  Student[]
  timetable TimetableSlot[]

  @@index([collegeId])
}

model Teacher {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId    String    @db.Uuid
  userId       String    @unique @db.Uuid
  departmentId String    @db.Uuid
  designation  String
  joiningDate  DateTime
  salaryGrade  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  college    College         @relation(fields: [collegeId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  department Department      @relation(fields: [departmentId], references: [id])
  timetable  TimetableSlot[]
  attendance Attendance[]
  assignments Assignment[]

  @@index([collegeId])
}

model Student {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId        String    @db.Uuid
  userId           String    @unique @db.Uuid
  admissionNumber  String
  departmentId     String    @db.Uuid
  sectionId        String?   @db.Uuid
  batchYear        String
  rollNumber       String
  bloodGroup       String?
  emergencyContact String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  college        College                @relation(fields: [collegeId], references: [id])
  user           User                   @relation(fields: [userId], references: [id])
  department     Department             @relation(fields: [departmentId], references: [id])
  section        Section?               @relation(fields: [sectionId], references: [id])
  enrollments    Enrollment[]
  attendance     Attendance[]
  marks          Mark[]
  fees           Fee[]
  scholarships   Scholarship[]
  assignmentSubs AssignmentSubmission[]
  parents        ParentStudentLink[]

  @@index([collegeId])
}

model Parent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())

  college  College             @relation(fields: [collegeId], references: [id])
  user     User                @relation(fields: [userId], references: [id])
  students ParentStudentLink[]

  @@index([collegeId])
}

model ParentStudentLink {
  parentId  String @db.Uuid
  studentId String @db.Uuid

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model Enrollment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  studentId String   @db.Uuid
  courseId  String   @db.Uuid
  semester  Int
  status    String   @default("enrolled") // enrolled | dropped | completed
  createdAt DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@index([collegeId, studentId])
}

// ----------------------------------------------------------------------
// ADMISSIONS
// ----------------------------------------------------------------------

model Admission {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId          String    @db.Uuid
  applicantName      String
  marksheetDetails   Json
  departmentId       String    @db.Uuid
  status             String    // submitted | shortlisted | rejected | seat_allotted | payment_pending | confirmed
  cutoffCheckResult  Json?
  seatHoldExpiresAt  DateTime?
  createdFromLeadId  String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  college    College    @relation(fields: [collegeId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@index([collegeId, status])
}

// ----------------------------------------------------------------------
// ATTENDANCE
// ----------------------------------------------------------------------

model Attendance {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId            String   @db.Uuid
  studentId            String   @db.Uuid
  courseId             String   @db.Uuid
  teacherId            String   @db.Uuid
  date                 DateTime @db.Date
  status               String   // present | absent | late
  markedAt             DateTime @default(now())
  isLateEntry          Boolean  @default(false)
  submittedWithinWindow Boolean @default(true)

  college College @relation(fields: [collegeId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([collegeId, studentId, date])
}

// ----------------------------------------------------------------------
// EXAMS & MARKS
// ----------------------------------------------------------------------

model Exam {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  courseId  String   @db.Uuid
  name      String
  type      String   // midterm | final | practical | assignment
  date      DateTime @db.Date
  maxMarks  Float
  status    String   @default("pending") // pending | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
  marks   Mark[]

  @@index([collegeId, courseId])
}

model Mark {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId          String   @db.Uuid
  examId             String   @db.Uuid
  studentId          String   @db.Uuid
  obtainedMarks      Float
  remarks            String?
  enteredByTeacherId String   @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id])
  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([collegeId, studentId])
}

// ----------------------------------------------------------------------
// FEES & SCHOLARSHIPS
// ----------------------------------------------------------------------

model FeeStructure {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId    String   @db.Uuid
  semester     Int
  departmentId String?  @db.Uuid
  totalAmount  Float
  dueDate      DateTime
  createdAt    DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id])
  fees    Fee[]

  @@index([collegeId])
}

model Fee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId      String   @db.Uuid
  studentId      String   @db.Uuid
  feeStructureId String   @db.Uuid
  status         String   @default("pending") // overdue | partial | paid | pending
  amountDue      Float
  amountPaid     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  college      College              @relation(fields: [collegeId], references: [id])
  student      Student              @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure         @relation(fields: [feeStructureId], references: [id])
  transactions PaymentTransaction[]

  @@index([collegeId, status])
  @@index([collegeId, studentId])
}

model Scholarship {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String   @db.Uuid
  studentId     String   @db.Uuid
  category      String   // SC | ST | BC | MBC | FG
  amountCovered Float
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([collegeId, studentId])
}

model PaymentTransaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId  String   @db.Uuid
  feeId      String   @db.Uuid
  gateway    String   // razorpay
  gatewayRef String?
  amount     Float
  status     String   // success | failed | pending
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id])
  fee     Fee     @relation(fields: [feeId], references: [id])

  @@index([collegeId])
}

// ----------------------------------------------------------------------
// LEAVE
// ----------------------------------------------------------------------

model LeaveRequest {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId           String   @db.Uuid
  requesterUserId     String   @db.Uuid
  requesterRole       String
  fromDate            DateTime @db.Date
  toDate              DateTime @db.Date
  reason              String
  medicalCertUrl      String?
  status              String   @default("pending") // pending | approved | rejected
  reviewedBy          String?  @db.Uuid
  substituteTeacherId String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
}

// ----------------------------------------------------------------------
// TIMETABLE
// ----------------------------------------------------------------------

model TimetableSlot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId    String   @db.Uuid
  departmentId String   @db.Uuid
  sectionId    String   @db.Uuid
  dayOfWeek    Int      // 0 = Sunday, 1 = Monday
  startTime    String   // HH:mm
  endTime      String   // HH:mm
  courseId     String   @db.Uuid
  teacherId    String   @db.Uuid
  room         String
  createdAt    DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  // DB Constraints for double booking prevention
  @@unique([collegeId, dayOfWeek, startTime, room], name: "unique_room_booking")
  @@unique([collegeId, dayOfWeek, startTime, teacherId], name: "unique_teacher_booking")
  @@index([collegeId, teacherId, dayOfWeek])
}

// ----------------------------------------------------------------------
// ASSIGNMENTS
// ----------------------------------------------------------------------

model Assignment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String   @db.Uuid
  courseId      String   @db.Uuid
  teacherId     String   @db.Uuid
  title         String
  description   String
  dueDate       DateTime
  attachmentUrl String?
  createdAt     DateTime @default(now())

  college     College                @relation(fields: [collegeId], references: [id])
  course      Course                 @relation(fields: [courseId], references: [id])
  teacher     Teacher                @relation(fields: [teacherId], references: [id])
  submissions AssignmentSubmission[]

  @@index([collegeId, courseId])
}

model AssignmentSubmission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId    String   @db.Uuid
  assignmentId String   @db.Uuid
  studentId    String   @db.Uuid
  fileUrl      String
  submittedAt  DateTime @default(now())
  status       String   @default("submitted") // submitted | late | graded
  score        Float?
  feedback     String?

  college    College    @relation(fields: [collegeId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([collegeId, studentId])
}

// ----------------------------------------------------------------------
// SUPPORTING MODULES (Stubs)
// ----------------------------------------------------------------------

model LibraryItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  title     String
  college   College  @relation(fields: [collegeId], references: [id])
}

model HostelBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  college   College  @relation(fields: [collegeId], references: [id])
}

model TransportRoute {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  college   College  @relation(fields: [collegeId], references: [id])
}

model InfrastructureAsset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  college   College  @relation(fields: [collegeId], references: [id])
}

model Notice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  title     String
  audience  String   // all | students | teachers | parents
  college   College  @relation(fields: [collegeId], references: [id])
}

model Complaint {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  subject   String
  status    String   @default("open") // open | in_progress | resolved
  college   College  @relation(fields: [collegeId], references: [id])
  
  @@index([collegeId, status])
}

model Placement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String   @db.Uuid
  companyName String
  eligibility Json?
  college     College  @relation(fields: [collegeId], references: [id])
}

model StoreItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  college   College  @relation(fields: [collegeId], references: [id])
}

model PayrollRecord {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  month     String
  college   College  @relation(fields: [collegeId], references: [id])
}

model DocumentVault {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @db.Uuid
  fileName  String
  college   College  @relation(fields: [collegeId], references: [id])
}
