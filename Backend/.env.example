# ----------------------------------------------------------------------
# Zuna ERP - Environment Configuration
# ----------------------------------------------------------------------

# Railway automatically injects PORT, DATABASE_URL, and REDIS_URL

# Web Server Port
PORT=5000

# PostgreSQL Connection (Prisma formatted)
# E.g. postgresql://postgres:password@localhost:5432/postgres?connection_limit=15&pool_timeout=10
DATABASE_URL=""

# Redis Connection (For Cache-Aside & Rate Limiting)
# E.g. redis://default:password@localhost:6379
REDIS_URL=""

# JWT Secrets (Must be long, random strings in production)
JWT_SECRET="super_secret_jwt_key_for_access_tokens"
JWT_REFRESH_SECRET="super_secret_jwt_key_for_refresh_tokens"

# Optional: AWS S3 or Cloudflare R2 Credentials for file uploads
# S3_ENDPOINT=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET_NAME=""
