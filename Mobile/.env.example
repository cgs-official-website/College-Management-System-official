# DEVELOPMENT (used by default: npx react-native run-android)
# Physical phone + `adb reverse tcp:5000 tcp:5000`  -> http://localhost:5000/api/v1
# Android emulator                                  -> http://10.0.2.2:5000/api/v1
# iOS simulator                                     -> http://localhost:5000/api/v1
API_URL=http://localhost:5000/api/v1
SENTRY_DSN=
